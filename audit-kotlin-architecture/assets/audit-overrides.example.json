{
  "schema_version": 1,
  "root_package": "com.example",
  "feature_root": "feature",
  "target_feature_layers": [],
  "create_feature_test_support": false,
  "shared_test_modules": [],
  "foundation_modules": [],
  "features": [
    {
      "name": "orders",
      "package_prefixes": ["com.example.orders"],
      "path_prefixes": ["app/src/main/kotlin/com/example/orders"],
      "include_globs": [],
      "exclude_globs": [],
      "target_layers": ["domain", "data", "navigation", "shared-ui", "ui"]
    },
    {
      "name": "checkout",
      "package_prefixes": ["com.example.checkout"],
      "path_prefixes": ["app/src/main/kotlin/com/example/checkout"],
      "include_globs": [],
      "exclude_globs": [],
      "target_layers": ["domain", "data", "navigation", "ui"]
    }
  ],
  "file_overrides": {
    "app/src/main/kotlin/com/example/legacy/OrderGateway.kt": {
      "feature": "orders",
      "layer": "domain",
      "reason": "Approved domain port despite its legacy package."
    }
  },
  "shared_assignments": {
    "app/src/main/kotlin/com/example/time/Clock.kt": ":util:time:domain"
  },
  "shared_ui_dependencies": [
    {
      "consumer": ":feature:checkout:ui",
      "provider": ":feature:orders:shared-ui"
    }
  ]
}
