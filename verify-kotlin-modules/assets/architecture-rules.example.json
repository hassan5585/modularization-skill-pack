{
  "schema_version": 1,
  "feature_root": "feature",
  "core_root": "core",
  "utility_root": "util",
  "required_feature_layers": ["domain", "data", "navigation", "ui"],
  "required_feature_layers_by_feature": {},
  "required_test_modules": [],
  "check_settings_registration": true,
  "test_support_names": ["test", "test-support", "fixtures"],
  "module_roles": {
    "*/domain": "domain",
    "*/data": "data",
    "*/navigation": "navigation",
    "*/shared-ui": "shared-ui",
    "*/ui": "ui",
    "*/test": "test-support"
  },
  "forbidden_target_roles": {
    "domain": ["data", "navigation", "shared-ui", "ui", "app", "test-support"],
    "data": ["navigation", "shared-ui", "ui", "app", "test-support"],
    "navigation": ["data", "shared-ui", "ui", "app", "test-support"],
    "shared-ui": ["data", "shared-ui", "app", "test-support"],
    "ui": ["data", "app", "test-support"],
    "aggregation": ["test-support"]
  },
  "cross_feature": {
    "severity": "error",
    "allowed_target_roles": ["domain", "navigation"],
    "allowed_role_edges": {
      "ui": ["shared-ui"]
    }
  },
  "direct_project_imports": {
    "severity": null
  },
  "dependency_visibility": {
    "api_project_dependency_severity": "warning",
    "allowed_api_project_dependencies": [
      {
        "source": ":feature:orders",
        "target": ":feature:orders:domain",
        "reason": "The optional aggregation root is the documented app-facing Kotlin feature facade."
      },
      {
        "source": ":feature:orders",
        "target": ":feature:orders:data",
        "reason": "The optional aggregation root is the documented app-facing Kotlin feature facade."
      },
      {
        "source": ":feature:orders",
        "target": ":feature:orders:navigation",
        "reason": "The optional aggregation root is the documented app-facing Kotlin feature facade."
      },
      {
        "source": ":feature:orders",
        "target": ":feature:orders:shared-ui",
        "reason": "The optional aggregation root exposes its approved provider-owned shared UI to Kotlin consumers."
      },
      {
        "source": ":feature:orders",
        "target": ":feature:orders:ui",
        "reason": "The optional aggregation root is the documented app-facing Kotlin feature facade."
      },
      {
        "source": ":feature:orders:navigation",
        "target": ":core:navigation",
        "reason": "Public destination contracts extend core navigation types."
      },
      {
        "source": ":feature:orders:test",
        "target": ":test:core",
        "reason": "Public reusable test fixtures expose shared test-foundation contracts."
      },
      {
        "source": ":test:core",
        "target": ":core:domain",
        "reason": "Public core-domain fakes implement and expose core domain contracts."
      },
      {
        "source": ":test:core",
        "target": ":core:navigation",
        "reason": "Public navigation fakes implement and expose core navigation contracts."
      }
    ]
  },
  "native_framework": {
    "exported_dependency_severity": "error",
    "export_flag_severity": "error",
    "transitive_export_severity": "error",
    "disabled_phase_severity": "error"
  },
  "conventions": {
    "included_builds": ["build-logic"],
    "validate_included_build_plugins": true,
    "required_registered_plugin_ids": [
      "com.example.convention.feature.domain",
      "com.example.convention.feature.data",
      "com.example.convention.feature.navigation",
      "com.example.convention.feature.ui",
      "com.example.convention.test.support"
    ],
    "required_plugins_by_role": {
      "domain": {"any_of": ["example.feature.domain", "com.example.convention.feature.domain"], "all_of": []},
      "data": {"any_of": ["example.feature.data", "com.example.convention.feature.data"], "all_of": []},
      "navigation": {"any_of": ["example.feature.navigation", "com.example.convention.feature.navigation"], "all_of": []},
      "shared-ui": {"any_of": ["example.feature.ui", "com.example.convention.feature.ui"], "all_of": []},
      "ui": {"any_of": ["example.feature.ui", "com.example.convention.feature.ui"], "all_of": []},
      "test-support": {"any_of": ["example.test.support", "com.example.convention.test.support"], "all_of": []}
    },
    "forbidden_plugins_by_role": {}
  },
  "ignored_paths": [
    "build",
    ".gradle",
    ".git",
    "generated"
  ],
  "ignored_import_prefixes": [],
  "exceptions": []
}
